# User-owned SITE source is maintained outside the GD-PVP release boundary.
/apps/gdpvp-site/

# Browser state is local-only; never version login sessions.
playwright/.auth/
.browser-state/

# Generated development acceptance artifacts, never source or login state.
browser-acceptance/
live-evidence/

# Source-bound local validation output, never application input.
release-verification/
release-candidate/
portable-candidate/

# Locally generated reports, never source payload.
/runs/

# Private opt-in browser cookie snapshots and locks (never source/artifacts).
.radar-sessions/
.radar-acceptance/
