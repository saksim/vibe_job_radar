# Copy to .env beside compose.yaml; never put the password itself here.
RADAR_ORIGIN=http://localhost:8080
RADAR_PASSWORD_FILE=/etc/vibe-radar/secrets/radar-password
RADAR_IMAGE=ghcr.io/saksim/vibe_job_radar:0.20.3
# For an exact release artifact use ghcr.io/saksim/vibe_job_radar@sha256:<verified digest>.
# Production: set the exact external HTTPS origin, without a path or trailing slash.
# RADAR_ORIGIN=https://radar.example.com
# Local-source override only: RADAR_BUILD_IMAGE=vibe-job-radar-workbench:local
